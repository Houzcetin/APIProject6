@model GetProductByIdDto
@{
    ViewData["Title"] = "UpdateProduct";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10">
                <div class="card">
                    <div class="card-header">
                        <h4>
                            <i class="fas fa-pen text-primary mr-2"></i>
                            Update Product
                        </h4>
                        <div class="card-header-action">
                            <a href="/Product/ProductList/" class="btn btn-outline-primary rounded-pill px-3">
                                <i class="fas fa-arrow-left mr-1"></i> Back to list
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger">
                                <i class="fas fa-exclamation-triangle mr-2"></i>
                                Update failed: @ViewBag.Error
                            </div>
                        }
                        <form method="post">
                            <input type="hidden" asp-for="ProductId" />
                            <div class="row">
                                <div class="col-md-4 text-center mb-4">
                                    <div class="update-img-wrap mb-3">
                                        <img id="imagePreview" src="@Model.ImageURL" alt="@Model.ProductName"
                                             onerror="this.onerror=null;this.src='/yummy-red-1.0.0/assets/img/menu/menu-item-1.png';">
                                    </div>
                                    <label>Image URL</label>
                                    <input type="text" asp-for="ImageURL" id="imageUrlInput" class="form-control" />
                                </div>
                                <div class="col-md-8">
                                    <div class="form-group">
                                        <label>Product Name</label>
                                        <input type="text" asp-for="ProductName" class="form-control" required />
                                    </div>
                                    <div class="form-row">
                                        <div class="form-group col-md-6">
                                            <label>Product Price (₺)</label>
                                            <input type="text" asp-for="Price" class="form-control" required />
                                        </div>
                                        <div class="form-group col-md-6">
                                            <label>Product's Category</label>
                                            <select asp-for="CategoryId" class="form-control"
                                                    asp-items="(IEnumerable<SelectListItem>)ViewBag.CategoryValues">
                                                <option value="">--Select Category--</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label>Product Description</label>
                                        <textarea class="form-control" asp-for="ProductDescription" rows="5"></textarea>
                                    </div>
                                    <div class="text-right">
                                        <button type="submit" class="btn btn-primary rounded-pill px-4">
                                            <i class="fas fa-save mr-1"></i> Update Product
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .update-img-wrap {
        height: 200px;
        border-radius: 12px;
        overflow: hidden;
        background: #f4f5f8;
        border: 1px solid #eee;
    }

        .update-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const input = document.getElementById('imageUrlInput');
            const preview = document.getElementById('imagePreview');
            input.addEventListener('change', function () {
                preview.src = this.value;
            });
        });
    </script>
}
