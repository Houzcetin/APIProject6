@model CreateProductDto
@{
    ViewData["Title"] = "CreateProduct";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    //(IEnumerable<SelectListItem>)ViewBag.categoryValues
}





<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>New Product Page</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <label>Product Name</label>
                            <input type="text" asp-for="ProductName" class="form-control" />
                            <br />
                            <label>Product Price</label>
                            <input type="text" asp-for="Price" class="form-control" />
                            <br />
                            <label>Product's Category</label>
                            <select asp-for="CategoryId" class="form-control" asp-items="(IEnumerable<SelectListItem>)ViewBag.CategoryValues">
                                <option value="">--Select Category--</option>
                            </select>
                           
                            <br />
                            <label>Image URL</label>
                            <input type="text" asp-for="ImageURL" class="form-control" />
                            <br />
                            <label>Product Description</label>
                            <textarea class="form-control" asp-for="ProductDescription" rows="5"></textarea>
                            <br />
                            
                            <button class="btn btn-primary">Create Prodcut</button>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
