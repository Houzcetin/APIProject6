@model List<ResultFeatureDto>

@{
    ViewData["Title"] = "FeatureList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10">

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <div class="card feature-card">
                            <div class="card-header">
                                <h4>
                                    <i class="fas fa-star text-primary mr-2"></i>
                                    Feature Ops
                                </h4>
                                <div class="card-header-action">
                                    <a href="/Feature/UpdateFeature/@item.FeatureID/" class="btn btn-primary">
                                        <i class="fas fa-pen mr-1"></i> Update
                                    </a>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="row align-items-center">

                                    <div class="col-md-5 mb-4 mb-md-0">
                                        <div class="feature-img-wrap">
                                            <img src="@item.ImageURL" alt="@item.Title"
                                                 onerror="this.onerror=null;this.src='/yummy-red-1.0.0/assets/img/about.jpg';">
                                            @if (!string.IsNullOrWhiteSpace(item.VideoURL))
                                            {
                                                <a href="@item.VideoURL" target="_blank" rel="noopener"
                                                   class="feature-play-btn" title="Watch video">
                                                    <i class="fas fa-play"></i>
                                                </a>
                                            }
                                        </div>
                                    </div>

                                    <div class="col-md-7">
                                        <span class="feature-subtitle">@item.SubTitle</span>
                                        <h2 class="feature-title">@item.Title</h2>
                                        <p class="feature-description">@item.Description</p>

                                        <div class="mt-4">
                                            <a href="/Feature/UpdateFeature/@item.FeatureID/"
                                               class="btn btn-outline-success rounded-pill px-4 mr-2">
                                                <i class="fas fa-pen mr-1"></i> Update
                                            </a>
                                            <a href="/Feature/DeleteFeature/@item.FeatureID/"
                                               class="btn btn-outline-danger rounded-pill px-4 delete-feature-btn"
                                               data-title="@item.Title">
                                                <i class="fas fa-trash-alt mr-1"></i> Delete
                                            </a>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="card">
                        <div class="card-body text-center text-muted py-5">
                            <i class="fas fa-star mb-3" style="font-size: 40px; opacity: .3;"></i>
                            <h5 class="mb-2">No feature yet</h5>
                            <p class="mb-4">Create a feature to showcase it on the site.</p>
                            <a href="/Feature/CreateFeature/" class="btn btn-primary rounded-pill px-4">
                                <i class="fas fa-plus mr-1"></i> Enter New Feature
                            </a>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</section>

<style>
    .feature-card {
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .feature-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
        }

    .feature-img-wrap {
        position: relative;
        height: 260px;
        border-radius: 12px;
        overflow: hidden;
        background: #f4f5f8;
    }

        .feature-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .feature-play-btn {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 62px;
        height: 62px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.92);
        color: #6777ef;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
        transition: transform 0.2s ease, background 0.2s ease;
    }

        .feature-play-btn:hover {
            background: #fff;
            color: #6777ef;
            transform: translate(-50%, -50%) scale(1.1);
        }

    .feature-subtitle {
        display: inline-block;
        color: #6777ef;
        font-weight: 700;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 6px;
    }

    .feature-title {
        font-size: 28px;
        font-weight: 700;
        color: #34395e;
        margin-bottom: 14px;
    }

    .feature-description {
        color: #6c757d;
        line-height: 1.7;
        margin-bottom: 0;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.delete-feature-btn').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    const title = this.getAttribute('data-title');
                    if (!confirm('"' + title + '" feature kaydını silmek istediğine emin misin?')) {
                        e.preventDefault();
                    }
                });
            });
        });
    </script>
}
