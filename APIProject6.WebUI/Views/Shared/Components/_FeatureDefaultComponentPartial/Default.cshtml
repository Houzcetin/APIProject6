@model List<ResultFeatureDto>

@functions {
    private string ResolveImageUrl(string imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            return Url.Content("~/yummy-red-1.0.0/assets/img/hero-img.png");
        }

        imageUrl = imageUrl.Trim().Replace("\\", "/");

        // Bir dosya yolunun sonundaki "/" (ör. "hero-img.png/") görseli 404 yapar; temizle.
        if (!imageUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) &&
            !imageUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            imageUrl = imageUrl.TrimEnd('/');
        }

        if (imageUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            imageUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return imageUrl;
        }

        if (imageUrl.StartsWith("~"))
        {
            return Url.Content(imageUrl);
        }

        if (imageUrl.StartsWith("/assets/", StringComparison.OrdinalIgnoreCase))
        {
            return Url.Content("~/yummy-red-1.0.0" + imageUrl);
        }

        if (imageUrl.StartsWith("/wwwroot/", StringComparison.OrdinalIgnoreCase))
        {
            return Url.Content("~/" + imageUrl.Substring("/wwwroot/".Length));
        }

        if (imageUrl.StartsWith("/"))
        {
            return imageUrl;
        }

        if (imageUrl.StartsWith("wwwroot/", StringComparison.OrdinalIgnoreCase))
        {
            return Url.Content("~/" + imageUrl.Substring("wwwroot/".Length));
        }

        if (imageUrl.StartsWith("assets/", StringComparison.OrdinalIgnoreCase))
        {
            return Url.Content("~/yummy-red-1.0.0/" + imageUrl);
        }

        if (!imageUrl.Contains("/"))
        {
            return Url.Content("~/yummy-red-1.0.0/assets/img/" + imageUrl);
        }

        return Url.Content("~/" + imageUrl);
    }
}

@foreach (var item in Model)
{
    <section id="hero" class="hero section light-background">

        <div class="container">
            <div class="row gy-4 justify-content-center justify-content-lg-between">
                <div class="col-lg-5 order-2 order-lg-1 d-flex flex-column justify-content-center">
                    <h1 data-aos="fade-up">@item.Title<br>@item.SubTitle</h1>
                    <p data-aos="fade-up" data-aos-delay="100">@item.Description</p>
                    <div class="d-flex" data-aos="fade-up" data-aos-delay="200">
                        <a href="#book-a-table" class="btn-get-started">Reservation</a>
                        <a href="@item.VideoURL" class="glightbox btn-watch-video d-flex align-items-center"><i class="bi bi-play-circle"></i><span>Watch Video</span></a>
                    </div>
                </div>
                <div class="col-lg-5 order-1 order-lg-2 hero-img" data-aos="zoom-out">
                    <img src="@ResolveImageUrl(item.ImageURL)" class="img-fluid animated" alt="@item.Title">
                </div>
            </div>
        </div>

    </section>
}
