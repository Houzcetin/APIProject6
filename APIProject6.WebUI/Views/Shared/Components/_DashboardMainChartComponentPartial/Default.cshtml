@model APIProject6.WebUI.Models.RevenueChartViewModel
@using Newtonsoft.Json

<div class="card">
    <!-- Card Header -->
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Reservation Chart</h4>

        <div class="card-header-action">
            <div class="btn-group">
                <button type="button" class="btn btn-warning dropdown-toggle" data-bs-toggle="dropdown">
                    Options
                </button>

                <ul class="dropdown-menu">
                    <li>
                        <a class="dropdown-item" href="#">
                            <i class="fas fa-eye"></i> View
                        </a>
                    </li>

                    <li>
                        <a class="dropdown-item" href="#">
                            <i class="far fa-edit"></i> Edit
                        </a>
                    </li>

                    <li>
                        <hr class="dropdown-divider">
                    </li>

                    <li>
                        <a class="dropdown-item text-danger" href="#">
                            <i class="far fa-trash-alt"></i> Delete
                        </a>
                    </li>
                </ul>
            </div>

            <a href="#" class="btn btn-primary ms-2">View All</a>
        </div>
    </div>

    <!-- Card Body -->
    <div class="card-body">
        <div class="row">

            <!-- Chart and Summary Cards -->
            <div class="col-lg-9 border-end">

                <!-- Chart -->
                <div class="p-3 bg-light mb-3" style="height: 330px;">
                    <canvas id="reservationChart"></canvas>
                </div>

                <!-- Bottom Boxes -->
                <div class="row text-center">

                    <div class="col-md-4 mb-3">
                        <div class="p-3">
                            <i class="fas fa-calendar-check text-success"></i>
                            <h5 class="mb-1">@Model.TotalReservations</h5>
                            <p class="text-muted mb-0">Total Reservations</p>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="p-3">
                            <i class="fas fa-users text-primary"></i>
                            <h5 class="mb-1">@Model.TotalGuests</h5>
                            <p class="text-muted mb-0">Total Guests</p>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="p-3">
                            <i class="fas fa-user-plus text-warning"></i>
                            <h5 class="mb-1">@Model.NewCustomers</h5>
                            <p class="text-muted mb-0">New Customers</p>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Right Stats -->
            <div class="col-lg-3">
                <div class="mt-4">

                    <div class="d-flex justify-content-between mb-3">
                        <span>Waiting Approval</span>
                        <span>
                            <strong>@Model.WaitingReservations</strong>
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Approved</span>
                        <span>
                            <strong>@Model.ApprovedReservations</strong>
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Cancelled</span>
                        <span>
                            <strong>@Model.CancelledReservations</strong>
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Completed</span>
                        <span>
                            <strong>@Model.CompletedReservations</strong>
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>No Show</span>
                        <span>
                            <strong>@Model.NoShowReservations</strong>
                        </span>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    var ctx = document.getElementById('reservationChart').getContext('2d');

    var reservationChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: @Html.Raw(JsonConvert.SerializeObject(Model.Labels)),
            datasets: [
                {
                    label: 'Approved',
                    data: @Html.Raw(JsonConvert.SerializeObject(Model.Approved)),
                    borderColor: '#198754',
                    backgroundColor: 'rgba(25, 135, 84, 0.1)',
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#198754'
                },
                {
                    label: 'Waiting for Approval',
                    data: @Html.Raw(JsonConvert.SerializeObject(Model.WaitingForApproval)),
                    borderColor: '#ffc107',
                    backgroundColor: 'rgba(255, 193, 7, 0.1)',
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#ffc107'
                },
                {
                    label: 'Cancelled',
                    data: @Html.Raw(JsonConvert.SerializeObject(Model.Cancelled)),
                    borderColor: '#dc3545',
                    backgroundColor: 'rgba(220, 53, 69, 0.1)',
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#dc3545'
                },
                {
                    label: 'Completed',
                    data: @Html.Raw(JsonConvert.SerializeObject(Model.Completed)),
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13, 110, 253, 0.1)',
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#0d6efd'
                },
                {
                    label: 'No Show',
                    data: @Html.Raw(JsonConvert.SerializeObject(Model.NoShow)),
                    borderColor: '#6c757d',
                    backgroundColor: 'rgba(108, 117, 125, 0.1)',
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#6c757d'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,

            plugins: {
                legend: {
                    display: true,
                    position: 'top'
                }
            },

            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        stepSize: 1
                    }
                }
            }
        }
    });
</script>