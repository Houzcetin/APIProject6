@model List<ResultGroupReservationDto>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4>Assign Task Table</h4>
                <div class="card-header-form">
                    <form>
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="Search">
                            <div class="input-group-btn">
                                <button class="btn btn-primary"><i class="fas fa-search"></i></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead class="bg-light">

                            <tr>
                                <th class="text-center">
                                    <div class="custom-checkbox custom-checkbox-table custom-control">
                                        <input type="checkbox" data-checkboxes="mygroup" data-checkbox-role="dad"
                                               class="custom-control-input" id="checkbox-all">
                                        <label for="checkbox-all" class="custom-control-label">&nbsp;</label>
                                    </div>
                                </th>
                                <th>Task Name</th>
                                <th>ReservationOwner</th>
                                <th>Count of People</th>
                                <th>Task Status</th>
                                <th>Assign Date</th>
                                <th>Due Date</th>
                                <th>Priority</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                string statusClass = item.ReservationStatus switch
                                {
                                    "Approved" => "badge-success",
                                    "Pending" => "badge-warning",
                                    "Cancelled" => "badge-danger",
                                    _ => "badge-secondary"
                                };

                                string statusIcon = item.ReservationStatus switch
                                {
                                    "Approved" => "fas fa-check-circle",
                                    "Pending" => "fas fa-hourglass-half",
                                    "Cancelled" => "fas fa-times-circle",
                                    _ => "fas fa-info-circle"
                                };

                                string priorityIcon = item.Priority switch
                                {
                                    "High" => "fas fa-exclamation-circle text-danger",
                                    "Medium" => "fas fa-chevron-up text-warning",
                                    "Low" => "fas fa-minus-circle text-success",
                                    _ => "fas fa-circle"
                                };

                                <tr class="table-row-modern">
                                    <td style="width: 35px;">
                                        <input type="checkbox" />
                                    </td>
                                    <td class="fw-semibold">
                                        <i class="fas fa-users text-primary me-2"></i>
                                        @item.GroupTitle
                                    </td>
                                    <td>
                                        <i class="fas fa-user text-secondary me-2"></i>
                                        @item.ReservationOwner
                                    </td>
                                    <td>
                                        <i class="fas fa-user-friends text-info me-2"></i>
                                        @item.PersonCount
                                    </td>
                                    <td>
                                        <span class="badge @statusClass px-3 py-2 rounded-pill">
                                            <i class="@statusIcon me-1"></i>
                                            @item.ReservationStatus
                                        </span>
                                    </td>
                                    <td>
                                        <i class="fas fa-calendar-alt text-warning me-2"></i>
                                        @item.LastProcessDate.ToString("dd-MMM-yyyy")
                                    </td>
                                    <td>
                                        <i class="fas fa-calendar-check text-success me-2"></i>
                                        @item.ReservationDate.ToString("dd-MMM-yyyy")
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark px-3 py-2 rounded-pill">
                                            <i class="@priorityIcon me-1"></i>
                                            @item.Priority
                                        </span>
                                    </td>
                                    <td>
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm rounded-pill px-3 detail-btn"
                                                data-id="@item.GroupReservationId"
                                                data-title="@item.GroupTitle"
                                                data-responsible="@item.ReservationOwner"
                                                data-email="@item.Email"
                                                data-status="@item.ReservationStatus"
                                                data-person-count="@item.PersonCount"
                                                data-reservation-date="@item.ReservationDate.ToString("dd MMM yyyy")"
                                                data-last-process="@item.LastProcessDate.ToString("dd MMM yyyy")"
                                                data-reservation-date-iso="@item.ReservationDate.ToString("o")"
                                                data-last-process-iso="@item.LastProcessDate.ToString("o")"
                                                data-priority="@item.Priority"
                                                data-details="@item.Details"
                                                data-status-class="@statusClass"
                                                data-status-icon="@statusIcon"
                                                data-priority-icon="@priorityIcon">
                                            <i class="fas fa-info-circle me-1"></i> Details
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- Modern Popup Modal (custom, no Bootstrap JS dependency) -->
        <div class="custom-modal" id="reservationDetailModal" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 shadow-lg rounded-4" style="background: white;">
                    <!-- Modal Header -->
                    <div class="modal-header border-0 bg-gradient-primary text-white rounded-top-4 py-4 position-relative">
                        <div>
                            <h5 class="modal-title fw-bold mb-1" id="reservationDetailModalLabel">
                                <i class="fas fa-info-circle me-2"></i>
                                <span id="modal-title">Rezervasyon Detayları</span>
                            </h5>
                            <small class="opacity-75">Grup rezervasyon bilgileri</small>
                        </div>
                        <button type="button" class="btn-close btn-close-white modal-close-btn js-modal-close" aria-label="Close"></button>
                    </div>

                    <!-- Modal Body -->
                    <div class="modal-body p-4">
                        <div class="row g-4">
                            <!-- Left Column -->
                            <div class="col-md-6">
                                <div class="detail-card p-3 rounded-3 bg-light h-100">
                                    <h6 class="text-primary fw-bold mb-3">
                                        <i class="fas fa-user-circle me-2"></i>Yetkili Bilgileri
                                    </h6>
                                    <div class="detail-item mb-3">
                                        <label class="text-muted small mb-1">Yetkili Kişi</label>
                                        <p class="mb-0 fw-semibold" id="modal-responsible">
                                            <i class="fas fa-user text-primary me-2"></i>
                                            <span></span>
                                        </p>
                                    </div>
                                    <div class="detail-item">
                                        <label class="text-muted small mb-1">E-posta</label>
                                        <p class="mb-0" id="modal-email">
                                            <i class="fas fa-envelope text-primary me-2"></i>
                                            <span></span>
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column -->
                            <div class="col-md-6">
                                <div class="detail-card p-3 rounded-3 bg-light h-100">
                                    <h6 class="text-success fw-bold mb-3">
                                        <i class="fas fa-calendar-check me-2"></i>Rezervasyon Bilgileri
                                    </h6>
                                    <div class="detail-item mb-3">
                                        <label class="text-muted small mb-1">Kişi Sayısı</label>
                                        <p class="mb-0 fw-semibold" id="modal-person-count">
                                            <i class="fas fa-user-friends text-success me-2"></i>
                                            <span></span>
                                        </p>
                                    </div>
                                    <div class="detail-item">
                                        <label class="text-muted small mb-1">Rezervasyon Tarihi</label>
                                        <p class="mb-0" id="modal-reservation-date">
                                            <i class="fas fa-calendar-alt text-success me-2"></i>
                                            <span></span>
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Status and Priority -->
                            <div class="col-12">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="detail-card p-3 rounded-3 bg-light">
                                            <label class="text-muted small mb-2" for="modal-status-select">Durum</label>
                                            <select id="modal-status-select" class="form-control">
                                                <option value="Pending">Pending</option>
                                                <option value="Approved">Approved</option>
                                                <option value="Cancelled">Cancelled</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="detail-card p-3 rounded-3 bg-light">
                                            <label class="text-muted small mb-2" for="modal-priority-select">Öncelik</label>
                                            <select id="modal-priority-select" class="form-control">
                                                <option value="High">High</option>
                                                <option value="Medium">Medium</option>
                                                <option value="Low">Low</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Last Process Date -->
                            <div class="col-12">
                                <div class="detail-card p-3 rounded-3 bg-light">
                                    <label class="text-muted small mb-1">Son İşlem Tarihi</label>
                                    <p class="mb-0" id="modal-last-process">
                                        <i class="fas fa-clock text-warning me-2"></i>
                                        <span></span>
                                    </p>
                                </div>
                            </div>

                            <!-- Details -->
                            <div class="col-12">
                                <div class="detail-card p-3 rounded-3 bg-light">
                                    <label class="text-muted small mb-2" for="modal-details">
                                        <i class="fas fa-file-alt me-2"></i>Detaylı Açıklama
                                    </label>
                                    <textarea class="form-control" id="modal-details" rows="3"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Modal Footer -->
                    <div class="modal-footer border-0 bg-light rounded-bottom-4">
                        <button type="button" class="btn btn-secondary rounded-pill px-4 modal-action-btn js-modal-close">
                            <i class="fas fa-times me-2"></i>Close
                        </button>
                        <button type="button" class="btn btn-primary rounded-pill px-4 modal-action-btn js-modal-update">
                            <i class="fas fa-edit me-2"></i>Update
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <style>
            .table-row-modern:hover {
                background-color: #f8f9fa !important;
                transition: 0.2s ease-in-out;
            }

            .rounded-4 {
                border-radius: 1rem !important;
            }

            .bg-gradient-primary {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            }

            .detail-card {
                transition: all 0.3s ease;
            }

                .detail-card:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
                }

            .detail-item label {
                font-size: 0.85rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            /* Self-contained modal — no Bootstrap JS/CSS dependency */
            .custom-modal {
                display: none;
                position: fixed;
                inset: 0;
                z-index: 2000;
                background-color: rgba(0, 0, 0, 0.5);
                overflow-y: auto;
                padding: 1.75rem;
            }

                .custom-modal.show {
                    display: flex;
                }

                .custom-modal .modal-dialog {
                    margin: auto;
                    width: 100%;
                    max-width: 800px;
                }

            .modal-content {
                overflow: hidden;
                background: white !important;
            }

            .modal-close-btn,
            .modal-action-btn {
                position: relative !important;
                cursor: pointer !important;
                pointer-events: auto !important;
            }

            .btn-close:focus {
                box-shadow: none !important;
                opacity: 1 !important;
            }

            .btn-close:hover {
                opacity: 0.8 !important;
            }

            .badge-success {
                background-color: #28a745 !important;
                color: white;
            }

            .badge-warning {
                background-color: #ffc107 !important;
                color: #000;
            }

            .badge-danger {
                background-color: #dc3545 !important;
                color: white;
            }

            .text-justify {
                text-align: justify;
                line-height: 1.6;
            }
        </style>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const detailButtons = document.querySelectorAll('.detail-btn');
                const modalElement = document.getElementById('reservationDetailModal');

                // Holds the reservation currently shown in the modal (for the Update payload)
                let currentReservation = null;

                detailButtons.forEach(button => {
                    button.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();

                        // Get data from button attributes
                        const title = this.getAttribute('data-title');
                        const responsible = this.getAttribute('data-responsible');
                        const email = this.getAttribute('data-email');
                        const status = this.getAttribute('data-status');
                        const personCount = this.getAttribute('data-person-count');
                        const reservationDate = this.getAttribute('data-reservation-date');
                        const lastProcess = this.getAttribute('data-last-process');
                        const priority = this.getAttribute('data-priority');
                        const details = this.getAttribute('data-details');

                        // Keep the identifying / non-editable fields for the update payload
                        currentReservation = {
                            groupReservationId: parseInt(this.getAttribute('data-id'), 10),
                            reservationOwner: responsible,
                            groupTitle: title,
                            reservationDate: this.getAttribute('data-reservation-date-iso'),
                            lastProcessDate: this.getAttribute('data-last-process-iso')
                        };

                        // Update modal content
                        document.getElementById('modal-title').textContent = title;
                        document.querySelector('#modal-responsible span').textContent = responsible;
                        document.querySelector('#modal-email span').textContent = email || 'Belirtilmemiş';
                        document.querySelector('#modal-person-count span').textContent = personCount + ' Kişi';
                        document.querySelector('#modal-reservation-date span').textContent = reservationDate;
                        document.querySelector('#modal-last-process span').textContent = lastProcess;

                        // Editable fields
                        document.getElementById('modal-details').value = details || '';
                        document.getElementById('modal-status-select').value = status;
                        document.getElementById('modal-priority-select').value = priority;

                        // Show modal (plain JS — independent of Bootstrap version)
                        openModal();
                    });
                });

                function openModal() {
                    modalElement.classList.add('show');
                    modalElement.setAttribute('aria-hidden', 'false');
                    document.body.style.overflow = 'hidden';
                }

                function closeModal() {
                    modalElement.classList.remove('show');
                    modalElement.setAttribute('aria-hidden', 'true');
                    document.body.style.overflow = '';
                }

                // Close buttons (header X + footer Close)
                modalElement.querySelectorAll('.js-modal-close').forEach(btn => {
                    btn.addEventListener('click', function(e) {
                        e.preventDefault();
                        closeModal();
                    });
                });

                // Update button
                const updateBtn = modalElement.querySelector('.js-modal-update');
                if (updateBtn) {
                    updateBtn.addEventListener('click', async function(e) {
                        e.preventDefault();
                        if (!currentReservation) return;

                        const payload = {
                            groupReservationId: currentReservation.groupReservationId,
                            reservationOwner: currentReservation.reservationOwner,
                            groupTitle: currentReservation.groupTitle,
                            reservationDate: currentReservation.reservationDate,
                            lastProcessDate: currentReservation.lastProcessDate,
                            reservationStatus: document.getElementById('modal-status-select').value,
                            priority: document.getElementById('modal-priority-select').value,
                            details: document.getElementById('modal-details').value
                        };

                        updateBtn.disabled = true;
                        const originalHtml = updateBtn.innerHTML;
                        updateBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Updating...';

                        try {
                            const response = await fetch('/Dashboard/UpdateGroupReservation', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(payload)
                            });
                            const result = await response.json();

                            if (response.ok && result.success) {
                                closeModal();
                                location.reload();
                            } else {
                                alert(result.message || 'Update failed. Please try again.');
                                updateBtn.disabled = false;
                                updateBtn.innerHTML = originalHtml;
                            }
                        } catch (err) {
                            alert('An error occurred while updating.');
                            updateBtn.disabled = false;
                            updateBtn.innerHTML = originalHtml;
                        }
                    });
                }

                // Backdrop click closes the modal
                modalElement.addEventListener('click', function(e) {
                    if (e.target === modalElement) {
                        closeModal();
                    }
                });

                // Esc key closes the modal
                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape' && modalElement.classList.contains('show')) {
                        closeModal();
                    }
                });
            });
        </script>
    </div>
</div>
