@model List<ResultContactDto>

@{
    ViewData["Title"] = "Contact Information";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<style>
    :root {
        --purple-grad: linear-gradient(135deg, #7c5cdd, #a078e6);
        --blue-grad: linear-gradient(135deg, #5c6bc0, #7986cb);
        --pink-grad: linear-gradient(135deg, #ff7eb3, #ff758c);
        --light-bg: #f8fafc;
        --border-color: #f1f5f9;
        --text-muted: #94a3b8;
        --text-dark: #334155;
    }

    .contact-row-wrapper {
        margin-bottom: 40px;
    }

    .contact-card-box {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
        display: flex;
        flex-direction: column;
        height: 100%;
        border: 1px solid rgba(0,0,0,0.02);
    }

    .contact-card-header {
        background: var(--purple-grad);
        color: white;
        padding: 16px 20px;
        font-weight: 600;
        font-size: 1.05rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .contact-card-body {
        padding: 20px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .info-item {
        display: flex;
        align-items: center;
        background: var(--light-bg);
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 15px;
        transition: transform 0.2s;
    }

    .info-item:hover {
        transform: translateY(-2px);
    }

    .info-icon-box {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        background: var(--purple-grad);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.2rem;
        flex-shrink: 0;
        margin-right: 15px;
    }

    .info-text-box {
        flex-grow: 1;
    }

    .info-label {
        font-size: 0.75rem;
        color: var(--text-muted);
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-bottom: 3px;
    }

    .info-value {
        font-size: 0.95rem;
        color: var(--text-dark);
        font-weight: 500;
        margin: 0;
    }

    .action-buttons {
        display: flex;
        gap: 15px;
        margin-top: auto;
        padding-top: 10px;
    }

    .btn-grad {
        flex: 1;
        padding: 12px;
        border-radius: 10px;
        color: white;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: none;
        transition: all 0.3s;
    }

    .btn-edit-grad {
        background: var(--purple-grad);
        box-shadow: 0 4px 15px rgba(124, 92, 221, 0.3);
    }

    .btn-edit-grad:hover {
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(124, 92, 221, 0.4);
    }

    .btn-delete-grad {
        background: var(--pink-grad);
        box-shadow: 0 4px 15px rgba(255, 117, 140, 0.3);
    }

    .btn-delete-grad:hover {
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(255, 117, 140, 0.4);
    }

    .map-container {
        flex-grow: 1;
        padding: 0;
        position: relative;
        min-height: 400px;
    }

    .map-container iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100% !important;
        height: 100% !important;
        border: none;
    }

    .header-controls {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 25px;
    }

    .btn-add-contact {
        background: #fff;
        color: #7c5cdd;
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s;
        border: 1px solid #7c5cdd;
    }

    .btn-add-contact:hover {
        background: #7c5cdd;
        color: #fff;
    }

</style>

<section class="section">
    <div class="section-body mt-4">
        
        <div class="header-controls">
            <a href="/Contact/CreateContact/" class="btn-add-contact">
                <i class="fa fa-plus"></i> Add New Contact
            </a>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 bg-white" style="border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
                <i class="fa fa-address-book-o mb-3" style="font-size: 4rem; color: #cbd5e1;"></i>
                <h4 style="color: #475569;">No Contact Information Found</h4>
                <p style="color: #94a3b8;">There are currently no contact addresses added to the system.</p>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="row contact-row-wrapper">
                    <!-- Left Side: Contact Info -->
                    <div class="col-lg-6 mb-4 mb-lg-0">
                        <div class="contact-card-box">
                            <div class="contact-card-header">
                                <i class="fa fa-address-card-o"></i> Contact Information
                            </div>
                            <div class="contact-card-body">
                                
                                <div class="info-item">
                                    <div class="info-icon-box">
                                        <i class="fa fa-map-marker"></i>
                                    </div>
                                    <div class="info-text-box">
                                        <div class="info-label">Address</div>
                                        <p class="info-value">@(string.IsNullOrEmpty(item.Address) ? "-" : item.Address)</p>
                                    </div>
                                </div>

                                <div class="info-item">
                                    <div class="info-icon-box">
                                        <i class="fa fa-phone"></i>
                                    </div>
                                    <div class="info-text-box">
                                        <div class="info-label">Phone</div>
                                        <p class="info-value">@(string.IsNullOrEmpty(item.Phone) ? "-" : item.Phone)</p>
                                    </div>
                                </div>

                                <div class="info-item">
                                    <div class="info-icon-box">
                                        <i class="fa fa-envelope-o"></i>
                                    </div>
                                    <div class="info-text-box">
                                        <div class="info-label">Email</div>
                                        <p class="info-value">@(string.IsNullOrEmpty(item.Email) ? "-" : item.Email)</p>
                                    </div>
                                </div>

                                <div class="info-item">
                                    <div class="info-icon-box">
                                        <i class="fa fa-clock-o"></i>
                                    </div>
                                    <div class="info-text-box">
                                        <div class="info-label">Open Hours</div>
                                        <p class="info-value">@(string.IsNullOrEmpty(item.OpenHours) ? "-" : item.OpenHours)</p>
                                    </div>
                                </div>

                                <div class="action-buttons">
                                    <a href="/Contact/UpdateContact/@item.ContactID/" class="btn-grad btn-edit-grad">
                                        <i class="fa fa-pencil-square-o"></i> Edit
                                    </a>
                                    <button type="button" class="btn-grad btn-delete-grad" onclick="confirmDelete('/Contact/DeleteContact/@item.ContactID/')">
                                        <i class="fa fa-trash"></i> Delete
                                    </button>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- Right Side: Map Location -->
                    <div class="col-lg-6">
                        <div class="contact-card-box">
                            <div class="contact-card-header">
                                <i class="fa fa-map-o"></i> Location
                            </div>
                            <div class="contact-card-body p-0">
                                <div class="map-container">
                                    @if (!string.IsNullOrEmpty(item.MapLocation))
                                    {
                                        if (item.MapLocation.Contains("<iframe"))
                                        {
                                            @Html.Raw(item.MapLocation)
                                        }
                                        else if (item.MapLocation.StartsWith("http"))
                                        {
                                            <iframe src="@item.MapLocation" loading="lazy"></iframe>
                                        }
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center h-100" style="background: #f8fafc; color: #cbd5e1; min-height: 400px;">
                                            <div class="text-center">
                                                <i class="fa fa-map-marker" style="font-size: 3rem; margin-bottom: 10px;"></i>
                                                <p>No map information provided.</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</section>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title"><i class="fa fa-exclamation-triangle mr-2"></i> Confirm Deletion</h5>
        <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close" style="background:none; border:none; outline:none; font-size: 1.5rem; color: white;">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body p-4 text-center">
        <i class="fa fa-trash-o text-danger mb-3" style="font-size: 3rem; opacity: 0.5;"></i>
        <p class="mb-0 h5 text-dark">Are you sure?</p>
        <p class="text-muted mt-2">Are you sure you want to delete this contact information? This process cannot be undone.</p>
      </div>
      <div class="modal-footer bg-light justify-content-center">
        <button type="button" class="btn btn-secondary px-4" data-dismiss="modal" style="border-radius: 8px;">Cancel</button>
        <a href="#" id="deleteConfirmBtn" class="btn btn-danger px-4" style="border-radius: 8px;">Yes, Delete It</a>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(url) {
            document.getElementById('deleteConfirmBtn').href = url;
            $('#deleteConfirmModal').modal('show');
        }
    </script>
}
