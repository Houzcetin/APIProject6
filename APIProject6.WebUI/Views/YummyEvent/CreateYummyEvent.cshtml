@model CreateYummyEventDto

@{
    ViewData["Title"] = "CreateYummyEvent";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>New Organization Addition List</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <label>Organization Title</label>
                            <input type="text" asp-for="Title" class="form-control" />
                            <br />
                            <label>Organization Description</label>
                            <input type="text" asp-for="Descritption" class="form-control" />
                            <br />
                            <label>Organization Price</label>
                            <input type="text" asp-for="Price" class="form-control" />
                            <br />
                            <label>Organization Image Url</label>
                            <input type="text" asp-for="ImageUrl" class="form-control" />
                            <br />
                            <button class="btn btn-primary">Create Organization</button>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

