@model List<ResultAboutDto>

@{
    ViewData["Title"] = "AboutList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10">

                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <div class="card about-card">
                            <div class="card-header">
                                <h4>
                                    <i class="fas fa-info-circle text-primary mr-2"></i>
                                    About
                                </h4>
                                <div class="card-header-action">
                                    <a href="/About/UpdateAbout/@item.AboutId/" class="btn btn-primary">
                                        <i class="fas fa-pen mr-1"></i> Update
                                    </a>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="row align-items-center">

                                    <div class="col-md-5 mb-4 mb-md-0">
                                        <div class="about-img-wrap">
                                            <img class="about-img-main" src="@item.ImageUrl" alt="@item.Title"
                                                 onerror="this.onerror=null;this.src='/yummy-red-1.0.0/assets/img/about.jpg';">
                                            <div class="about-img-inset">
                                                <img src="@item.VideoCoverImageUrl" alt="video cover"
                                                     onerror="this.onerror=null;this.src='/yummy-red-1.0.0/assets/img/about-2.jpg';">
                                                @if (!string.IsNullOrWhiteSpace(item.VideoUrl))
                                                {
                                                    <a href="@item.VideoUrl" target="_blank" rel="noopener"
                                                       class="about-play-btn" title="Watch video">
                                                        <i class="fas fa-play"></i>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-7">
                                        <h2 class="about-title">@item.Title</h2>

                                        @if (!string.IsNullOrWhiteSpace(item.ReservationNumber))
                                        {
                                            <div class="about-reservation mb-3">
                                                <i class="fas fa-phone-alt mr-2"></i>
                                                <span class="text-muted mr-1">Reservation:</span>
                                                <strong>@item.ReservationNumber</strong>
                                            </div>
                                        }

                                        <div class="about-description">@item.Description</div>

                                        <div class="mt-4">
                                            <a href="/About/UpdateAbout/@item.AboutId/"
                                               class="btn btn-outline-success rounded-pill px-4 mr-2">
                                                <i class="fas fa-pen mr-1"></i> Update
                                            </a>
                                            <a href="/About/DeleteAbout/@item.AboutId/"
                                               class="btn btn-outline-danger rounded-pill px-4 delete-about-btn"
                                               data-title="@item.Title">
                                                <i class="fas fa-trash-alt mr-1"></i> Delete
                                            </a>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="card">
                        <div class="card-body text-center text-muted py-5">
                            <i class="fas fa-info-circle mb-3" style="font-size: 40px; opacity: .3;"></i>
                            <h5 class="mb-2">No about content yet</h5>
                            <p class="mb-4">Create an about section to showcase it on the site.</p>
                            <a href="/About/CreateAbout/" class="btn btn-primary rounded-pill px-4">
                                <i class="fas fa-plus mr-1"></i> Enter a new About
                            </a>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</section>

<style>
    .about-card {
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .about-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.12);
        }

    .about-img-wrap {
        position: relative;
        height: 300px;
    }

    .about-img-main {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 12px;
        background: #f4f5f8;
    }

    .about-img-inset {
        position: absolute;
        bottom: -20px;
        right: -20px;
        width: 45%;
        height: 55%;
        border: 5px solid #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
    }

        .about-img-inset img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            background: #f4f5f8;
        }

    .about-play-btn {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.92);
        color: #6777ef;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
        transition: transform 0.2s ease, background 0.2s ease;
    }

        .about-play-btn:hover {
            background: #fff;
            transform: translate(-50%, -50%) scale(1.1);
        }

    .about-title {
        font-size: 26px;
        font-weight: 700;
        color: #34395e;
        margin-bottom: 14px;
    }

    .about-reservation {
        display: inline-flex;
        align-items: center;
        background: #f4f5fb;
        color: #34395e;
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 14px;
    }

    .about-description {
        color: #6c757d;
        line-height: 1.8;
        white-space: pre-line;
        max-height: 220px;
        overflow-y: auto;
        padding-right: 6px;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.delete-about-btn').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    const title = this.getAttribute('data-title');
                    if (!confirm('"' + title + '" about kaydını silmek istediğine emin misin?')) {
                        e.preventDefault();
                    }
                });
            });
        });
    </script>
}
