@model List<ResultImageDto>
@{
    ViewData["Title"] = "ImageList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<style>
    :root {
        --primary-color: #4a6cf7;
        --card-radius: 16px;
        --transition-speed: 0.4s;
    }

    .admin-gallery-section {
        padding: 30px 0;
        background: transparent;
    }

    .gallery-header-box {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 20px;
        padding: 25px 30px;
        margin-bottom: 30px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.03);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .gallery-header-title h4 {
        margin: 0;
        font-weight: 800;
        font-size: 1.4rem;
        color: #1e293b;
        letter-spacing: -0.5px;
    }

    .gallery-header-title p {
        margin: 5px 0 0 0;
        color: #64748b;
        font-size: 0.95rem;
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 30px;
    }

    .gallery-card {
        position: relative;
        border-radius: var(--card-radius);
        overflow: hidden;
        aspect-ratio: 4 / 3;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        cursor: pointer;
        background: #e2e8f0;
        animation: fadeUp 0.6s ease forwards;
        opacity: 0;
        transform: translateY(20px);
    }

    /* Animate cards sequentially */
    .gallery-card:nth-child(1) { animation-delay: 0.1s; }
    .gallery-card:nth-child(2) { animation-delay: 0.2s; }
    .gallery-card:nth-child(3) { animation-delay: 0.3s; }
    .gallery-card:nth-child(4) { animation-delay: 0.4s; }
    .gallery-card:nth-child(5) { animation-delay: 0.5s; }
    .gallery-card:nth-child(6) { animation-delay: 0.6s; }

    @@keyframes fadeUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .gallery-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--transition-speed) cubic-bezier(0.4, 0, 0.2, 1);
    }

    .gallery-card:hover img {
        transform: scale(1.1);
    }

    .gallery-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(15, 23, 42, 0.9) 0%, rgba(15, 23, 42, 0.2) 50%, rgba(15, 23, 42, 0) 100%);
        opacity: 0.7;
        transition: opacity var(--transition-speed) ease;
    }

    .gallery-card:hover .gallery-overlay {
        opacity: 0.9;
    }

    .gallery-content {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 25px 20px;
        color: white;
        transform: translateY(10px);
        transition: transform var(--transition-speed) ease;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .gallery-card:hover .gallery-content {
        transform: translateY(0);
    }

    .gallery-title {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 600;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 80%;
    }

    .gallery-zoom-icon {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(5px);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        transition: all var(--transition-speed) ease;
        opacity: 0;
        transform: scale(0.8);
    }

    .gallery-card:hover .gallery-zoom-icon {
        opacity: 1;
        transform: scale(1);
        background: var(--primary-color);
        box-shadow: 0 4px 15px rgba(74, 108, 247, 0.5);
    }

    /* Native Modal Styles */
    .custom-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        z-index: 99999;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        visibility: hidden;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .custom-modal-overlay.show {
        opacity: 1;
        visibility: visible;
    }

    .custom-modal-content {
        position: relative;
        max-width: 85vw;
        max-height: 85vh;
        transform: scale(0.95) translateY(20px);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 12px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .custom-modal-overlay.show .custom-modal-content {
        transform: scale(1) translateY(0);
    }

    .custom-modal-content img {
        max-width: 100%;
        max-height: 85vh;
        border-radius: 16px;
        object-fit: contain;
        display: block;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .custom-modal-close {
        position: absolute;
        top: -50px;
        right: 0;
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(5px);
        border: 1px solid rgba(255,255,255,0.2);
        color: white;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        font-size: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .custom-modal-close:hover {
        background: #ef4444;
        border-color: #ef4444;
        transform: rotate(90deg);
    }

    .custom-modal-title-bar {
        position: absolute;
        bottom: -50px;
        left: 0;
        right: 0;
        text-align: center;
        color: rgba(255,255,255,0.9);
        font-size: 1.1rem;
        font-weight: 500;
        letter-spacing: 0.5px;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: rgba(255,255,255,0.5);
        border: 2px dashed rgba(0,0,0,0.1);
        border-radius: 20px;
        margin-top: 20px;
    }
</style>

<section class="section admin-gallery-section">
    <div class="section-body">
        
        <!-- Premium Header -->
        <div class="gallery-header-box">
            <div class="gallery-header-title">
                <h4><i class="fa fa-camera-retro me-2" style="color: var(--primary-color);"></i> Medya Galerisi</h4>
                <p>Projenizde yer alan tüm görsellerin yüksek çözünürlüklü önizlemesi.</p>
            </div>
        </div>

        <!-- Gallery Grid -->
        <div class="gallery-grid">
            @foreach(var item in Model)
            {
                <div class="gallery-card" onclick="openCustomModal('@item.ImageURL', '@item.Title')">
                    <img src="@item.ImageURL" alt="@item.Title" loading="lazy">
                    <div class="gallery-overlay"></div>
                    <div class="gallery-content">
                        <h5 class="gallery-title" title="@item.Title">@item.Title</h5>
                        <div class="gallery-zoom-icon">
                            <i class="fa fa-expand"></i>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">
                <i class="fa fa-image mb-3" style="font-size: 4rem; color: #cbd5e1;"></i>
                <h5 style="color: #475569; font-weight: 600;">Görüntülenecek Medya Yok</h5>
                <p style="color: #94a3b8; margin:0;">Sisteme henüz herhangi bir görsel eklenmemiş.</p>
            </div>
        }
    </div>
</section>

<!-- Advanced Vanilla JS Lightbox -->
<div id="customImageModal" class="custom-modal-overlay" onclick="closeCustomModal(event)">
    <div class="custom-modal-content" onclick="event.stopPropagation()">
        <button class="custom-modal-close" onclick="closeCustomModal(event)">
            <i class="fa fa-times"></i>
        </button>
        <img id="customModalImage" src="" alt="Görsel">
        <div id="customModalTitle" class="custom-modal-title-bar"></div>
    </div>
</div>

<script>
    function openCustomModal(url, title) {
        const modal = document.getElementById('customImageModal');
        const img = document.getElementById('customModalImage');
        const titleEl = document.getElementById('customModalTitle');
        
        img.src = url;
        titleEl.textContent = title || 'İsimsiz Görsel';
        
        document.body.style.overflow = 'hidden'; // Scroll disable
        modal.classList.add('show');
    }

    function closeCustomModal(e) {
        if(e) e.stopPropagation();
        const modal = document.getElementById('customImageModal');
        
        modal.classList.remove('show');
        document.body.style.overflow = ''; // Scroll enable
        
        // Wait for animation to finish before clearing image
        setTimeout(() => {
            document.getElementById('customModalImage').src = '';
        }, 400); 
    }

    // Close with ESC key
    document.addEventListener('keydown', function(event) {
        if (event.key === "Escape") {
            const modal = document.getElementById('customImageModal');
            if (modal.classList.contains('show')) {
                closeCustomModal();
            }
        }
    });
</script>
